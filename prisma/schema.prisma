generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/**
 * ---------------- ADMIN ----------------
 */

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  sessions AdminSession[]
}

/**
 * ---------------- BLOG ----------------
 */

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model Blog {
  id      Int    @id @default(autoincrement())
  title   String
  slug    String @unique
  excerpt String @db.VarChar(300)
  content String @db.LongText

  coverImage String?
  images     Json?
  category   String?
  tags       Json?

  // SEO
  metaTitle       String?
  metaDescription String?
  ogImage         String?

  status   BlogStatus @default(DRAFT)
  featured Boolean    @default(false)

  views Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ---------------- PROJECTS ----------------
 */

enum ProjectCategory {
  WEB
  AIML
  GAME
}

enum ProjectStatus {
  COMPLETED
  IN_PROGRESS
  EXPERIMENT
}

model Project {
  id    Int    @id @default(autoincrement())
  title String
  slug  String @unique

  shortDescription String @db.VarChar(300)
  description      String @db.LongText

  category ProjectCategory @default(WEB)
  status   ProjectStatus   @default(COMPLETED)

  techStack Json

  coverImage String
  images     Json?
  videoUrl   String?

  link      String?
  githubUrl String?

  featured Boolean @default(false)
  order    Int?

  // 📅 Project Timeline
  startDate DateTime?
  endDate   DateTime?

  // 📊 Analytics
  views Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime?

  milestones ProjectMilestone[]
}

model ProjectMilestone {
  id        Int @id @default(autoincrement())
  projectId Int

  title   String
  summary String    @db.VarChar(500)
  date    DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

/**
 * ---------------- ADMIN SESSION ----------------
 */
model AdminSession {
  id        Int      @id @default(autoincrement())
  adminId   Int
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([adminId])
}
